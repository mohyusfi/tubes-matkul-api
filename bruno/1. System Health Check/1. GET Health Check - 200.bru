meta {
  name: 1. GET Health Check - 200
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq online
  res.body.version: eq 1.0.0
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Server status is online with valid metadata", function() {
    const data = res.getBody();
    expect(data.status).to.equal("online");
    expect(data.name).to.equal("Anime & Manga Watchlist Tracker API");
    expect(data.version).to.equal("1.0.0");
    expect(data.endpoints).to.be.an("object");
    expect(data.endpoints.auth).to.be.an("array");
    expect(data.endpoints.public).to.be.an("array");
    expect(data.endpoints.watchlist).to.be.an("array");
  });
}
