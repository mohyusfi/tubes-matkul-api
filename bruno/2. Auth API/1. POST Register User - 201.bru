meta {
  name: 1. POST Register User - 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{testUsername}}",
    "password": "{{testPassword}}"
  }
}

script:pre-request {
  const rand = Math.floor(Math.random() * 100000);
  const username = "user_" + Date.now().toString().slice(-4) + "_" + rand;
  bru.setEnvVar("testUsername", username);
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.username: eq {{testUsername}}
}

tests {
  test("Status code is 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Registration payload has userId and username", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.message).to.include("berhasil");
    expect(data.data.userId).to.be.a("number");
    expect(data.data.username).to.equal(bru.getEnvVar("testUsername"));
  });
}
