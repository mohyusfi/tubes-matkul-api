meta {
  name: 6. POST Login Missing Body - 400
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.success: eq false
}

tests {
  test("Status code is 400 Bad Request when fields are missing", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Validation message reminds required credentials", function() {
    const data = res.getBody();
    expect(data.success).to.be.false;
    expect(data.message).to.include("wajib");
  });
}
