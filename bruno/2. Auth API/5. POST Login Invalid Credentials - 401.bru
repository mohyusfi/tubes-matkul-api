meta {
  name: 5. POST Login Invalid Credentials - 401
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{testUsername}}",
    "password": "wrongPassword123"
  }
}

assert {
  res.status: eq 401
  res.body.success: eq false
}

tests {
  test("Status code is 401 Unauthorized for incorrect password", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Error message rejects unauthorized login", function() {
    const data = res.getBody();
    expect(data.success).to.be.false;
    expect(data.message).to.include("salah");
  });
}
