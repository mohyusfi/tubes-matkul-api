meta {
  name: 2. POST Register Validation Error - 400
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "usr",
    "password": "123"
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
}

tests {
  test("Status code is 400 Bad Request for short password", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Validation message is returned", function() {
    const data = res.getBody();
    expect(data.success).to.be.false;
    expect(data.message).to.be.a("string");
  });
}
