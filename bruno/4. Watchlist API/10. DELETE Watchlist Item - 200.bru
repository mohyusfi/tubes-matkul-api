meta {
  name: 10. DELETE Watchlist Item - 200
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/watchlist/{{watchlistId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Delete response message confirms item removal", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.message).to.include("berhasil dihapus");
  });
}
