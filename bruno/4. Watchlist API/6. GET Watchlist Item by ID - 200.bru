meta {
  name: 6. GET Watchlist Item by ID - 200
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/watchlist/{{watchlistId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: eq {{watchlistId}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Detail item matches created watchlist item", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.data.id).to.equal(bru.getEnvVar("watchlistId"));
    expect(data.data.title).to.equal("Fullmetal Alchemist: Brotherhood");
  });
}
