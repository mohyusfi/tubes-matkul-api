meta {
  name: 11. DELETE Watchlist Item Not Found - 404
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/watchlist/{{watchlistId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 404
  res.body.success: eq false
}

tests {
  test("Status code is 404 Not Found for already deleted item", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("Error message confirms item not found", function() {
    const data = res.getBody();
    expect(data.success).to.be.false;
    expect(data.message).to.include("tidak ditemukan");
  });
}
