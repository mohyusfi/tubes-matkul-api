meta {
  name: 9. PATCH Update Watchlist Validation Error - 400
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/watchlist/{{watchlistId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "score": 99
  }
}

assert {
  res.status: eq 400
  res.body.success: eq false
}

tests {
  test("Status code is 400 Bad Request for score > 10", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Validation message mentions score boundary", function() {
    const data = res.getBody();
    expect(data.success).to.be.false;
    expect(data.message).to.include("Score");
  });
}
