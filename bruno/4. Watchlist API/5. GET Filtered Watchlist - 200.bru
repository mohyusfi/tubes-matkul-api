meta {
  name: 5. GET Filtered Watchlist - 200
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/watchlist?type=anime&status=watching
  body: none
  auth: bearer
}

params:query {
  type: anime
  status: watching
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("Status code is 200 OK for filtered watchlist", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Every returned item matches type 'anime' and status 'watching'", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(Array.isArray(data.data)).to.be.true;
    data.data.forEach(item => {
      expect(item.item_type).to.equal("anime");
      expect(item.status).to.equal("watching");
    });
  });
}
