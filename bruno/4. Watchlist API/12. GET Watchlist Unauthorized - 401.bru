meta {
  name: 12. GET Watchlist Unauthorized - 401
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/watchlist
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.body.success: eq false
}

tests {
  test("Status code is 401 Unauthorized without auth header", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Error message informs token is required", function() {
    const data = res.getBody();
    expect(data.success).to.be.false;
    expect(data.message).to.include("Token");
  });
}
