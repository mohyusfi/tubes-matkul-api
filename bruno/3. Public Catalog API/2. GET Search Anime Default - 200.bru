meta {
  name: 2. GET Search Anime Default - 200
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/public/anime
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.length: gt 0
}

tests {
  test("Status code is 200 OK for default anime query", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns default list of anime", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(Array.isArray(data.data)).to.be.true;
    expect(data.data.length).to.be.above(0);
  });
}
