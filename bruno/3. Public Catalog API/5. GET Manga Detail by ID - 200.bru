meta {
  name: 5. GET Manga Detail by ID - 200
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/public/manga/11
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.mal_id: eq 11
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Detail manga has chapters, volumes, and authors", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.data.mal_id).to.equal(11);
    expect(data.data.title).to.include("Naruto");
    expect(data.data).to.have.property("chapters");
    expect(data.data).to.have.property("score");
  });
}
