meta {
  name: 5. GET Manga Detail by ID - 200
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/public/manga/35
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: eq 35
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Detail manga has title, chapters, and score", function() {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.data.id).to.equal(35);
    expect(data.data.title.toLowerCase()).to.include("naruto");
    expect(data.data).to.have.property("chapters");
    expect(data.data).to.have.property("score");
  });
}
